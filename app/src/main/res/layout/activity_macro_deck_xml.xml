<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0C0D14"
    android:orientation="vertical">

    <!-- Barra de Estado Superior HUD -->
    <RelativeLayout
        android:id="@+id/hudTopBar"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="#0F1018"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvAppTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="MACRO DECK 3"
                android:textColor="#00F0FF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvFolderName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="#88FFFFFF"
                android:textSize="12sp"
                tools:text="// Principal" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvConnectionStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="#161824"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:textColor="#00E676"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="192.168.1.100:8191 • 2ms" />

    </RelativeLayout>

    <!-- Cuadrícula RecyclerView en orientación horizontal para los botones -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDeckGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="8dp" />

</LinearLayout>
